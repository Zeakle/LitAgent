# Copy to .env for live use only. Never commit actual credentials.
# Presentation mode requires no credentials or external services.

# OpenAI-compatible API key. LLM_API_KEY takes precedence over OPENAI_API_KEY.
LLM_API_KEY=
OPENAI_API_KEY=
# config/default.yaml currently uses Ark and stage routing:
# extraction/planning/review/evaluation: doubao-seed-2-1-lite-260915
# generation/repair: doubao-seed-2-1-pro-260915
# Model access must be enabled with the provider. Live calls are billable.
# LITAGENT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LITAGENT_LLM_EXTRACTION_MODEL=doubao-seed-2-1-lite-260915
# LITAGENT_LLM_GENERATION_MODEL=doubao-seed-2-1-pro-260915
# LITAGENT_LLM_EVALUATION_MODEL=doubao-seed-2-1-lite-260915

# Optional LangFuse: current controlled runs use metadata-only traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# LITAGENT_OBSERVABILITY_ENABLED=true

# Optional Semantic Scholar credential; HTTP failures stay distinct from empty results.
SEMANTIC_SCHOLAR_API_KEY=

# New strict requests default to Jev admission; Judge stays off.
# Claim validity/source support AND claim format must pass before ledger entry.
# TYPESAFE_API_KEY is required unless extraction Jev is explicitly disabled.
# Transient HTTP failures may use only already verified pairs with complete usage.
# Unknown usage/auth/protocol/cancellation still stop; no automatic retries.
TYPESAFE_API_KEY=
# Optional independent Judge credentials; otherwise reuse the primary credential.
# LITAGENT_REPORT_AUDIT_JUDGE_API_KEY_ENV=BENCHMARK_JUDGE_API_KEY
BENCHMARK_JUDGE_API_KEY=

# Optional local runtime settings.
# LITAGENT_MEMORY_REDIS_URL=redis://localhost:6380
# LITAGENT_LOCAL_MODEL_DEVICE=cpu
# LITAGENT_LOCAL_RERANKER_PRECISION=float64
