# LitAgent 环境变量示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# ── LLM（必需）──
# DeepSeek / OpenAI 兼容 API key。client.py 读 LLM_API_KEY 或 OPENAI_API_KEY
OPENAI_API_KEY=

# ── LangFuse 可观测性（可选，启用 tracing 时需要）──
# 自托管 LangFuse 的项目凭证（在 LangFuse UI 里创建项目后生成）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Semantic Scholar（可选，强烈建议）──
# 不填则走全球共享池（长期饱和，几乎总是 429 → 该数据源降级返回空）。
# 填了走专属 1 RPS 额度（稳定可用）。免费申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── 配置覆盖（可选）──
# 任意 config 字段可用 LITAGENT_<SECTION>_<KEY> 覆盖，例如：
# LITAGENT_OBSERVABILITY_ENABLED=true      # 开启 tracing（bool）
# LITAGENT_MEMORY_REDIS_URL=redis://localhost:6380
# LITAGENT_LLM_MODEL=deepseek-chat

# 本地模型设备覆盖（可选）。Mac 并发 MPS 推理不稳定时可改用 CPU。
# LITAGENT_LOCAL_MODEL_DEVICE=cpu
# 若本机 CPU float32 重排返回非有限值，可使用 float64（较慢）。
# LITAGENT_LOCAL_RERANKER_PRECISION=float64

# 独立报告核验默认复用 LLM_API_KEY / OPENAI_API_KEY；独立 Judge 可配置：
# LITAGENT_REPORT_AUDIT_JUDGE_API_KEY_ENV=BENCHMARK_JUDGE_API_KEY
BENCHMARK_JUDGE_API_KEY=
# 勾选 Jev 时需要 TypeSafe key，缺失只禁用 Jev：
TYPESAFE_API_KEY=
