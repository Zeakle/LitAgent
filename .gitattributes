# Preserve the pinned upstream bytes and provenance hashes of vendored files.
src/litagent/csl/** -text
src/litagent/csl/citeproc.js -whitespace linguist-vendored
src/litagent/csl/CPAL -whitespace
# Preserve RFC 4180 CSV bytes while recognizing CRLF as a line ending.
benchmarks/survey/results/*/benchmark.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
